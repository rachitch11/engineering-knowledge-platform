APP_NAME="Engineering Knowledge Intelligence"
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
CHROMA_PATH=data/processed/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_UPLOAD_SIZE_BYTES=10485760
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CHROMA_COLLECTION_NAME=engineering_knowledge
BM25_INDEX_PATH=data/processed/bm25_index.json
RETRIEVAL_TOP_K=5
RRF_K=60
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_K=20
RERANK_TOP_K=5
MAX_EVIDENCE_CHUNKS=5
MAX_CONTEXT_CHARS=12000
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional local Ollama (LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
OPENAI_COMPATIBLE_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_WRITE_TIMEOUT_SECONDS=30
LLM_POOL_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1
LLM_MAX_OUTPUT_TOKENS=768
EVIDENCE_MIN_DENSE_SCORE=0.24
MAX_CONVERSATION_MESSAGES=12
MAX_CONVERSATION_CONTEXT_CHARS=4000
OLLAMA_NUM_PREDICT=512
RERANK_SKIP_SHORT_QUERIES=true
RERANK_SKIP_MAX_WORDS=5
LOG_PIPELINE_TIMINGS=true
# Default: isolated temp index per visitor (browser tab). Set false for one shared demo index.
EPHEMERAL_SESSIONS_ENABLED=true
SESSION_TTL_SECONDS=3600
SESSION_CLEANUP_INTERVAL_SECONDS=300
SESSION_STORE_ROOT=data/ephemeral_sessions
SINGLE_USER_MODE=false
BACKEND_URL=http://127.0.0.1:8000
# Optional: comma-separated origins for browser clients (Streamlit uses server-side HTTP).
# CORS_ALLOW_ORIGINS=https://your-ui.example.com
